# ---------------------------------------------------------------------------
# .env.example
# Copy this file to .env and fill in real values. Never commit the real .env.
# ---------------------------------------------------------------------------

# --- App ---
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# --- CORS (comma-separated origins allowed to call the API) ---
CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501

# --- File upload limits ---
MAX_UPLOAD_SIZE_MB=25
ALLOWED_UPLOAD_EXTENSIONS=.pdf,.docx,.pptx,.png,.jpg,.jpeg

# --- Storage paths (relative to project root) ---
UPLOAD_DIR=data/uploads
TEMPLATE_DIR=data/templates
GENERATED_DIR=data/generated
VERSION_DIR=data/versions
KNOWLEDGE_BASE_DIR=data/knowledge_base
SQLITE_DB_PATH=data/app.db

# --- LLM provider (Phase 4) ---
# Set which provider is active: gemini | openai | mock
LLM_PROVIDER=gemini
GEMINI_API_KEY= your_gemini_api_key_here
OPENAI_API_KEY=
OPENAI_BASE_URL=
GROQ_API_KEY=

# --- Embeddings (Phase 5) ---
EMBEDDING_MODEL=all-MiniLM-L6-v2

# --- Vector store (Phase 5) ---
# Set which store is active: faiss | pinecone
VECTOR_STORE=pinecone
PINECONE_API_KEY= your_pinecone_api_key_here
PINECONE_ENVIRONMENT=
PINECONE_INDEX_NAME=docgen-multiagent

# --- Web search (Phase 6) ---
# Set which provider is active: tavily | mock
WEB_SEARCH_PROVIDER=tavily
TAVILY_API_KEY=your_tavily_api_key_here
